{
  "id": "CSE-GDPR-PRINCIPLES-NO-ACCOUNTABILITY-009",
  "canonical_name": "Accountability Not Demonstrated",
  "description": "The controller cannot demonstrate compliance with GDPR data protection principles. Accountability requires documented evidence of compliance measures and their effectiveness.",
  "domain": "GDPR",
  "category": "PRINCIPLES",
  "applicability": "Applicable to all data controllers. Includes documentation of policies, procedures, training records, impact assessments, and processing records.",
