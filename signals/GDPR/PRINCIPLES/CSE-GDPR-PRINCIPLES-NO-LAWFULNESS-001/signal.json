{
  "id": "CSE-GDPR-PRINCIPLES-NO-LAWFULNESS-001",
  "canonical_name": "Processing Without Lawful Basis",
  "description": "Personal data is processed without a valid lawful basis as defined in GDPR Article 6. Processing must be justified by consent, contract performance, legal obligation, vital interests, public task, or legitimate interests.",
  "domain": "GDPR",
  "category": "PRINCIPLES",
  "applicability": "Applicable to any processing of personal data. Includes data collection, storage, analysis, sharing, and any other operation performed on personal data.",
  "introduced_in": "1.0.0",
  "status": "active",
  "metadata": {
    "suggested_severity": "critical",
    "risk_domains": [
      "data-protection",
      "lawfulness",
      "compliance"
    ],
    "related_controls": [
      "GDPR Art. 5.1.a",
      "GDPR Art. 6"
    ],
    "detection_notes": "Detected through review of processing activities, privacy notices, and consent records. Requires mapping each processing activity to a documented lawful basis.",
