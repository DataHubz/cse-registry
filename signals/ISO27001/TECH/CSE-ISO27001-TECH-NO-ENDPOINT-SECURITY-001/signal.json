{
  "id": "CSE-ISO27001-TECH-NO-ENDPOINT-SECURITY-001",
  "canonical_name": "No Endpoint Security Protection",
  "description": "Information stored on, processed by, or accessible via user endpoint devices is not protected.",
  "domain": "ISO27001",
  "category": "TECH",
  "applicability": "Applies to organizations that allow users to access, process, or store information on endpoint devices (laptops, desktops, mobile devices, tablets) without adequate security controls.",
  "introduced_in": "1.0.0",
  "status": "active",
  "metadata": {
    "suggested_severity": "high",
    "risk_domains": [
      "technology",
      "access-control",
      "data-protection",
      "endpoint-security"
    ],
    "related_controls": [
      "ISO 27001:2022 A.8.1"
    ],
    "detection_notes": "Review endpoint device policies, endpoint detection and response (EDR) implementations, device management solutions (MDM/UEM), encryption status, and security configurations on user devices.",
