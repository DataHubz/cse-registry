{
  "id": "CSE-ISO27001-PHYSICAL-NO-UTILITY-PROTECTION-011",
  "canonical_name": "No Supporting Utilities Protection",
  "description": "Information processing facilities are not protected from power failures and utility disruptions.",
  "domain": "ISO27001",
  "category": "PHYSICAL",
  "applicability": "Organizations with information processing facilities dependent on supporting utilities such as power, telecommunications, water, and HVAC systems",
  "introduced_in": "1.0.0",
  "status": "active",
  "metadata": {
    "suggested_severity": "high",
    "risk_domains": [
      "physical-security",
      "availability",
      "business-continuity",
      "infrastructure-protection"
    ],
    "related_controls": [
      "ISO 27001:2022 A.7.11"
    ],
    "detection_notes": "Assess protection measures for critical utilities including UPS systems, backup generators, redundant telecommunications, and HVAC systems. Absence of redundancy, backup power, or utility monitoring indicates this deficiency.",
