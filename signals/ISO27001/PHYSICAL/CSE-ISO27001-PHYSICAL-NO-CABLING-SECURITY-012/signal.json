{
  "id": "CSE-ISO27001-PHYSICAL-NO-CABLING-SECURITY-012",
  "canonical_name": "No Cabling Security",
  "description": "Cables carrying power and data are not protected from interception, interference, or damage.",
  "domain": "ISO27001",
  "category": "PHYSICAL",
  "applicability": "Organizations with power and data cabling infrastructure requiring protection from unauthorized access, tampering, and physical damage",
  "introduced_in": "1.0.0",
  "status": "active",
  "metadata": {
    "suggested_severity": "medium",
    "risk_domains": [
      "physical-security",
      "data-protection",
      "infrastructure-protection",
      "network-security"
    ],
    "related_controls": [
      "ISO 27001:2022 A.7.12"
    ],
    "detection_notes": "Assess cabling infrastructure for protection against interception (shielding, encryption), interference (separation from power), and damage (conduit, labeling, access control). Exposed cables, poor cable management, or unprotected cable runs indicate this deficiency.",
