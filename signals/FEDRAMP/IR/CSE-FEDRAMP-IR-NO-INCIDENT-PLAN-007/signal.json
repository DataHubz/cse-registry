      "security-operations",
      "threat-management"
    ],
    "related_controls": [
      "IR-8"
    ],
    "detection_notes": "Detection guidance: Look for missing incident response plan documentation, absence of response procedures and workflows, lack of defined roles and responsibilities, and missing communication plans for incident response.",
