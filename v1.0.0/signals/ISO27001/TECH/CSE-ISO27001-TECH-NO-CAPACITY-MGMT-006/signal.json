{
  "id": "CSE-ISO27001-TECH-NO-CAPACITY-MGMT-006",
  "canonical_name": "No Capacity Management",
  "description": "Use of resources is not monitored and adjusted with projections for future capacity requirements.",
  "domain": "ISO27001",
  "category": "TECH",
  "applicability": "Applies to organizations that do not monitor resource utilization (CPU, memory, storage, network bandwidth) or plan for future capacity needs, risking performance degradation or system unavailability.",
  "introduced_in": "1.0.0",
  "status": "active",
  "metadata": {
    "suggested_severity": "medium",
    "risk_domains": [
      "technology",
      "availability",
      "performance",
      "capacity-planning"
    ],
    "related_controls": [
      "ISO 27001:2022 A.8.6"
    ],
    "detection_notes": "Review capacity monitoring tools, resource utilization metrics, capacity planning processes, growth projections, performance baselines, and alerting mechanisms for capacity thresholds.",
