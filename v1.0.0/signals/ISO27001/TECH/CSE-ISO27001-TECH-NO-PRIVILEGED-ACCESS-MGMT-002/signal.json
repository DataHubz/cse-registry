{
  "id": "CSE-ISO27001-TECH-NO-PRIVILEGED-ACCESS-MGMT-002",
  "canonical_name": "No Privileged Access Management",
  "description": "Allocation and use of privileged access rights is not restricted and managed.",
  "domain": "ISO27001",
  "category": "TECH",
  "applicability": "Applies to organizations that grant privileged access rights (administrative, root, superuser) without proper restriction, approval, monitoring, or periodic review mechanisms.",
  "introduced_in": "1.0.0",
  "status": "active",
  "metadata": {
    "suggested_severity": "critical",
    "risk_domains": [
      "technology",
      "access-control",
      "identity-management",
      "privileged-access"
    ],
    "related_controls": [
      "ISO 27001:2022 A.8.2"
    ],
    "detection_notes": "Review privileged account inventories, approval processes, privileged access management (PAM) solutions, session monitoring, periodic access reviews, and segregation of duties for administrative rights.",
