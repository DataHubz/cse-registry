{
  "id": "CSE-ISO27001-PHYSICAL-NO-EQUIPMENT-PROTECTION-008",
  "canonical_name": "No Equipment Siting and Protection",
  "description": "Equipment is not sited securely and protected against environmental threats and unauthorized access.",
  "domain": "ISO27001",
  "category": "PHYSICAL",
  "applicability": "Organizations with information processing equipment that requires protection from environmental hazards and unauthorized access or damage",
  "introduced_in": "1.0.0",
  "status": "active",
  "metadata": {
