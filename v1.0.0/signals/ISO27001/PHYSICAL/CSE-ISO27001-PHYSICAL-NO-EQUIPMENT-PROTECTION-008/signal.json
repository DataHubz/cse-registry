      "asset-protection"
    ],
    "related_controls": [
      "ISO 27001:2022 A.7.8"
    ],
    "detection_notes": "Assess equipment placement considering environmental risks (water, heat, dust), physical access risks, and protection measures (secure mounting, cable locks, environmental controls). Equipment in vulnerable locations or lacking protective measures indicates this deficiency.",
