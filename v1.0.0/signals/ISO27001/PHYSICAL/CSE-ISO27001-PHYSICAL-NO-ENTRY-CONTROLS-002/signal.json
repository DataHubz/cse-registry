{
  "id": "CSE-ISO27001-PHYSICAL-NO-ENTRY-CONTROLS-002",
  "canonical_name": "No Physical Entry Controls",
  "description": "Secure areas are not protected by appropriate entry controls and access points.",
  "domain": "ISO27001",
  "category": "PHYSICAL",
  "applicability": "Organizations with secure areas requiring controlled access to protect sensitive information and assets",
  "introduced_in": "1.0.0",
  "status": "active",
  "metadata": {
    "suggested_severity": "high",
    "risk_domains": [
      "physical-security",
      "access-control",
      "unauthorized-access"
    ],
    "related_controls": [
      "ISO 27001:2022 A.7.2"
    ],
    "detection_notes": "Examine access control mechanisms at entry points to secure areas. Look for absence of badge readers, locks, security personnel, visitor management systems, or access logs. Unrestricted entry to sensitive areas indicates this deficiency.",
