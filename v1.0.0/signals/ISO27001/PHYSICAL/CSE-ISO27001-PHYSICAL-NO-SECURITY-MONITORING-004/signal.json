{
  "id": "CSE-ISO27001-PHYSICAL-NO-SECURITY-MONITORING-004",
  "canonical_name": "No Physical Security Monitoring",
  "description": "Premises are not continuously monitored for unauthorized physical access.",
  "domain": "ISO27001",
  "category": "PHYSICAL",
  "applicability": "Organizations requiring continuous monitoring of physical premises to detect and respond to unauthorized access attempts",
  "introduced_in": "1.0.0",
  "status": "active",
  "metadata": {
    "suggested_severity": "high",
    "risk_domains": [
      "physical-security",
      "surveillance",
      "incident-detection",
      "unauthorized-access"
    ],
    "related_controls": [
      "ISO 27001:2022 A.7.4"
    ],
    "detection_notes": "Assess whether continuous monitoring systems (CCTV, motion sensors, alarm systems, security personnel) are deployed and actively monitored. Absence of surveillance systems, unmonitored cameras, or lack of 24/7 monitoring indicates this deficiency. Note: A.7.4 is new in ISO 27001:2022.",
