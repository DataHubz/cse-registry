{
  "id": "CSE-ISO27001-PHYSICAL-NO-SECURITY-PERIMETER-001",
  "canonical_name": "No Physical Security Perimeters",
  "description": "Security perimeters are not defined and used to protect areas containing information and assets.",
  "domain": "ISO27001",
  "category": "PHYSICAL",
  "applicability": "Organizations with physical facilities that contain sensitive information or information processing equipment",
  "introduced_in": "1.0.0",
  "status": "active",
