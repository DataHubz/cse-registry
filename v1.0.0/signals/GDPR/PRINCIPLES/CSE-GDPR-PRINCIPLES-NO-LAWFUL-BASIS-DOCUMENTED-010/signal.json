{
  "id": "CSE-GDPR-PRINCIPLES-NO-LAWFUL-BASIS-DOCUMENTED-010",
  "canonical_name": "Lawful Basis Not Documented",
  "description": "The lawful basis for processing personal data is not documented for each processing activity. Controllers must identify and record the appropriate lawful basis before processing begins.",
  "domain": "GDPR",
  "category": "PRINCIPLES",
  "applicability": "Applicable to all personal data processing activities. Documentation should be maintained in records of processing activities as required by Article 30.",
  "introduced_in": "1.0.0",
  "status": "active",
