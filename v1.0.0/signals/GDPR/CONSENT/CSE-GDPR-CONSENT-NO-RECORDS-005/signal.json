{
  "id": "CSE-GDPR-CONSENT-NO-RECORDS-005",
  "canonical_name": "Consent Records Not Maintained",
  "description": "Controller does not maintain records demonstrating that valid consent was obtained. Article 7.1 requires controllers to be able to demonstrate that data subject has consented to processing.",
  "domain": "GDPR",
  "category": "CONSENT",
  "applicability": "Applicable to all consent-based processing. Controller must maintain evidence of consent including who consented, when, what information was provided, and how consent was obtained.",
  "introduced_in": "1.0.0",
  "status": "active",
  "metadata": {
    "suggested_severity": "high",
    "risk_domains": [
      "data-protection",
      "accountability",
      "evidence"
    ],
    "related_controls": [
      "GDPR Art. 7.1",
      "GDPR Art. 5.2"
    ],
    "detection_notes": "Detected through review of consent management systems and absence of consent records, timestamps, or audit trails.",
