  "status": "active",
  "metadata": {
    "suggested_severity": "medium",
    "risk_domains": [
      "risk-assessment",
      "vulnerability-management",
      "threat-analysis"
    ],
    "related_controls": [
      "RA-1"
    ],
    "detection_notes": "Detection guidance: Look for missing risk assessment policy documentation, absence of risk assessment procedures, lack of defined roles and responsibilities for risk assessment activities, and no evidence of policy dissemination to relevant stakeholders.",
